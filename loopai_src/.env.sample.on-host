#LoopAI Core
LOOPAI_LOCALHOST=http://loopai.local:8080
WEB_OR_CLI=web
WEB_IN_DOCKER=false

#PostgreSQL config 'localhost' if runs in localhost and postgres or db if in docker
POSTGRESQL_DB_HOST=localhost
POSTGRESQL_DB_NAME=loopai
POSTGRESQL_DB_NAME_WEB=loopai
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_USER=postgres
POSTGRESQL_DB_PASSWORD=admin
SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRESQL_DB_USER}:${POSTGRESQL_DB_PASSWORD}@${POSTGRESQL_DB_HOST}:${POSTGRESQL_DB_PORT}/${POSTGRESQL_DB_NAME}

# GPT API Configuration
GPT_API_KEY=your-gpt-api-key
GPT_API_URL=https://api.openai.com/v1/engines/davinci-codex/completions

# Other API Keys and Secrets
SECRET_KEY=your-secret-key
DEBUG=True

# Additional Configuration
MAX_CONTENT_LENGTH=16777216
LOG_LEVEL=INFO

CORS_ORIGINS=http://loopai.local:*,http://loopai.local:3000,http://loopai.local:5000,http://loopai.local:8080
CORS_ALLOW_ORIGIN_URL=http://loopai.local

# if running flask from inside the container WEB_IN_DOCKER=true
LOOPAI_ROOT=/app
LOOPAI_SINGLE_FILESYSTEM_PATH=/app/var/filesystem
LOOPAI_WEB_USERS_FILESYSTEM_PATH=/app/var/users

# in running flask on host and WEB_IN_DOCKER=false
LOOPAI_ROOT=/Users/macadmin/pyprojects/l-sdk-sep22/loopai_src/
LOOPAI_SINGLE_FILESYSTEM_PATH=/Users/macadmin/pyprojects/loopai-sdk/loopai_src/var/filesystem
LOOPAI_WEB_USERS_FILESYSTEM_PATH=/Users/macadmin/pyprojects/loopai-sdk/loopai_src/var/users