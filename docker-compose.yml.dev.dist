services:
  db:
    image: postgres
    container_name: postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
      POSTGRES_DB: loopai
      POSTGRESQL_DB_HOST: ${POSTGRESQL_DB_HOST}
      POSTGRESQL_DB_PORT: ${POSTGRESQL_DB_PORT}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  adminer:
    image: adminer
    container_name: adminer
    restart: always
    ports:
      - "8088:8080"

  web:
    build:
      context: ./loopai_src
      dockerfile: Dockerfile
    container_name: loopai_web
    ports:
      - "5000:5000"
    working_dir: /app
    volumes:
      - ./loopai_src:/app
    depends_on:
      - db
      - redis
    environment:
      - PYTHONPATH=/app
      - FLASK_APP=app.web  # Set to your Flask app entry point
      - FLASK_ENV=development
      - POSTGRESQL_DB_HOST=${POSTGRESQL_DB_HOST}
      - POSTGRESQL_DB_PORT=${POSTGRESQL_DB_PORT}
      - SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRESQL_DB_USER}:${POSTGRESQL_DB_PASSWORD}@${POSTGRESQL_DB_HOST}:${POSTGRESQL_DB_PORT}/${POSTGRESQL_DB_NAME}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    networks:
      - shared_network

    logging:
      driver: "syslog"  # Using syslog driver
      options:
        syslog-address: "udp://localhost:514"  # Address of the syslog server
        tag: "loopai_web"  # Optional tag for log identification


  frontend:
    build:
      context: ./loopai_src/view/vue/admin
      dockerfile: Dockerfile.frontend
      args:
        - VUE_APP_API_BASE_URL=${VUE_APP_API_BASE_URL}
    container_name: vue_admin
    ports:
      - "8080:80"
    environment:
      - VUE_APP_API_BASE_URL

    redis:
        image: redis:alpine
        container_name: redis
        ports:
          - "6379:6379"
        networks:
          - debug_network


  freshrss:
    image: freshrss/freshrss
    container_name: freshrss
    restart: unless-stopped
    ports:
      - "8183:80"
    environment:
      - CRON_MIN=*/20
      - TZ=Europe/Berlin
      - DATABASE_TYPE=pgsql
      - DATABASE_HOST=db
      - DATABASE_USER=${POSTGRESQL_DB_USER}
      - DATABASE_PASSWORD=${POSTGRESQL_DB_PASSWORD}
      - DATABASE_NAME=${POSTGRESQL_FRESH_RSS_DB_NAME}
    depends_on:
      - db
    volumes:
      - freshrss_data:/var/www/FreshRSS/data
      - ./containers/fresh_rss/extensions:/var/www/FreshRSS/extensions
    networks:
      - debug_network
      - shared_network



volumes:
  postgres_data:
    driver: local
  freshrss_data:
    driver: local

networks:
  debug_network:
  shared_network:
    external: true