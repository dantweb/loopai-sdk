@startuml Agent Life v2 - System Architecture
!define LIGHTORANGE #FFE4B5
!define LIGHTBLUE #B0E0E6
!define LIGHTGREEN #90EE90
!define LIGHTPINK #FFB6C1
!define LIGHTYELLOW #FFFFE0
!define LIGHTPURPLE #DDA0DD

skinparam backgroundColor #FAFAFA
skinparam roundcorner 10
skinparam shadowing true

title Agent Life v2 - System Architecture Overview

package "Frontend (Vue.js)" LIGHTBLUE {

  rectangle "AgentLife.vue\n(Main Container)" as MainContainer #4169E1

  package "Tab Components" LIGHTGREEN {
    rectangle "AgentLifeChat.vue\n(Messaging)" as Chat #32CD32
    rectangle "AgentLifeCycles.vue\n(Cycle Management)" as Cycles #228B22
    rectangle "AgentLifeMonitor.vue\n(Real-time Monitoring)" as Monitor #006400
    rectangle "AgentLifeConstellations.vue\n(Action Config)" as Constellations #008000
    rectangle "AgentLifeAnalytics.vue\n(Performance)" as Analytics #00FF00
  }

  rectangle "Pinia Store\n(State Management)" as PiniaStore #FF6347

  rectangle "Socket.IO Client\n(Real-time Events)" as SocketClient #FF4500
}

package "Backend (Flask)" LIGHTORANGE {

  rectangle "agentlife.py\n(API Routes)" as Routes #FF8C00

  package "Services" LIGHTPINK {
    rectangle "CycleManager\n(Lifecycle)" as CycleManager #FF69B4
    rectangle "ConstellationManager\n(Config)" as ConstellationManager #DB7093
    rectangle "ActionOrchestrator\n(Execution)" as ActionOrchestrator #C71585
    rectangle "StatusAggregator\n(Monitoring)" as StatusAggregator #FF1493
  }

  rectangle "Socket.IO Server\n(Event Broadcasting)" as SocketServer #DC143C
}

database "PostgreSQL" as DB LIGHTYELLOW {
  rectangle "cycle_configurations" as CycleConfigs #FFD700
  rectangle "cycle_executions" as CycleExecs #FFA500
  rectangle "cycle_execution_logs" as CycleLogs #FF8C00
  rectangle "action_constellations" as ActionConsts #FFB90F
}

cloud "Redis" as Redis LIGHTPURPLE {
  rectangle "Socket.IO\nPub/Sub" as RedisPubSub #9370DB
  rectangle "Cache" as RedisCache #8A2BE2
}

actor "User" as User #4169E1
cloud "Agent Services" as Agents #32CD32

' Frontend connections
User --> MainContainer : "Interacts with"
MainContainer --> Chat
MainContainer --> Cycles
MainContainer --> Monitor
MainContainer --> Constellations
MainContainer --> Analytics

Chat --> PiniaStore
Cycles --> PiniaStore
Monitor --> PiniaStore
Constellations --> PiniaStore
Analytics --> PiniaStore

PiniaStore --> Routes : "API Calls\n(REST)"
SocketClient --> SocketServer : "WebSocket\nEvents"

' Backend connections
Routes --> CycleManager
Routes --> ConstellationManager
Routes --> StatusAggregator

CycleManager --> ActionOrchestrator
CycleManager --> DB
ConstellationManager --> DB
ActionOrchestrator --> Agents : "Execute\nActions"
ActionOrchestrator --> StatusAggregator
StatusAggregator --> SocketServer : "Broadcast\nEvents"

' Database connections
CycleManager --> CycleConfigs
CycleManager --> CycleExecs
StatusAggregator --> CycleLogs
ConstellationManager --> ActionConsts

' Redis connections
SocketServer --> RedisPubSub
Routes --> RedisCache

' Legend
legend right
  |= Color |= Component Type |
  | <back:#B0E0E6>   </back> | Frontend |
  | <back:#FFE4B5>   </back> | Backend |
  | <back:#FFFFE0>   </back> | Database |
  | <back:#DDA0DD>   </back> | Cache/Messaging |
  | <back:#90EE90>   </back> | UI Components |
  | <back:#FFB6C1>   </back> | Services |
endlegend

note bottom of MainContainer
  **Frontend Framework**
  - Vue 3 with Composition API
  - Naive UI components
  - Pinia for state management
  - Socket.IO for real-time
end note

note bottom of Routes
  **Backend Framework**
  - Flask with SQLAlchemy
  - Flask-SocketIO
  - JWT authentication
  - RESTful API design
end note

note bottom of DB
  **Data Persistence**
  - PostgreSQL 12+
  - Indexed queries
  - Foreign key constraints
  - Full audit trail
end note

@enduml
