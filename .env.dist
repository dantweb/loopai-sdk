# .env for docker-compose
POSTGRESQL_DB_HOST=postgres
POSTGRESQL_DB_NAME=loopai
POSTGRESQL_DB_NAME_WEB=loopai
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_USER=postgres
POSTGRESQL_DB_PASSWORD=admin
SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRESQL_DB_USER}:${POSTGRESQL_DB_PASSWORD}@${POSTGRESQL_DB_HOST}:${POSTGRESQL_DB_PORT}/${POSTGRESQL_DB_NAME}

#backend API url - this is used by vueJs as endpoint (baked into the frontend image at build time)
VUE_APP_API_BASE_URL=http://localhost:5050/api
VUE_APP_API_BASE_HOST=http://localhost:5050

#postgress container specific for docker-compose
POSTGRES_USER=${POSTGRESQL_DB_USER}
POSTGRES_PASSWORD=${POSTGRESQL_DB_PASSWORD}
POSTGRES_DB=${POSTGRESQL_DB_NAME}

WEB_IN_DOCKER=true

REDIS_HOST=redis
REDIS_PORT=6379

OPENAI_API_KEY=

# host ports published by docker-compose (bin/install.sh picks free ones if busy)
LOOPAI_WEB_PORT=5050
LOOPAI_DEBUG_PORT=5678
LOOPAI_DB_PORT=5432
LOOPAI_REDIS_PORT=6379
LOOPAI_FRONTEND_PORT=8080
